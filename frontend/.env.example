# NAVISCAPE Frontend — Environment Template
# For local development, this defaults to http://127.0.0.1:8000/api in code if unset.
# For production deployment, set this to your deployed backend HTTPS URL:
# VITE_API_URL=https://<BACKEND_DOMAIN>/api
VITE_API_URL=http://127.0.0.1:8000/api

# Firebase Web Client Configuration (from Firebase Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
