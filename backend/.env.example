# NAVISCAPE — Environment Variables Template
# Copy this to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.

# ── Application ──────────────────────────────────────────────────────────────
# In production, set DEBUG=False
DEBUG=True

# ── CORS Configuration ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (HTTPS in production).
# Wildcard '*' is strictly rejected.
# Example: CORS_ORIGINS=https://naviscape.vercel.app,https://yourdomain.com
# Defaults to localhost (5173, 3000) when unset.
# CORS_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-hex-string

# ── External APIs ─────────────────────────────────────────────────────────────
TOMTOM_API_KEY=your-tomtom-api-key

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=NAVISCAPE

# ── OTP (optional overrides) ──────────────────────────────────────────────────
# OTP_EXPIRE_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_PER_EMAIL_PER_HOUR=5
# OTP_MAX_PER_IP_PER_HOUR=10
