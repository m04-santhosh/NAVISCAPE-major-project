# NAVISCAPE — Environment Variables Template
# Copy this to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.

# ── Application ──────────────────────────────────────────────────────────────
# In production, set DEBUG=False
DEBUG=True

# ── CORS Configuration ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (HTTPS in production).
# Wildcard '*' is strictly rejected.
# Example: CORS_ORIGINS=https://naviscape.vercel.app,https://yourdomain.com
# Defaults to localhost (5173, 3000) when unset.
# CORS_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-hex-string

# ── External APIs ─────────────────────────────────────────────────────────────
TOMTOM_API_KEY=your-tomtom-api-key

# ── Firebase & Firestore Configuration ────────────────────────────────────────
# Download service account JSON from Firebase Console -> Project Settings -> Service Accounts
# Option 1: File path relative to backend root or absolute path
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Option 2: Full JSON string (useful in serverless / cloud deployment environments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── SMTP / Email Configuration ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NaviScape

