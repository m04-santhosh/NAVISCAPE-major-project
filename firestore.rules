rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection: user documents can only be read/written by account owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Emergency Profiles: owner restricted
    match /emergency_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Trusted Contacts: owner restricted
    match /trusted_contacts/{contactId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.user_id == request.auth.uid
      );
    }

    // 4. Emergency Events / SOS: owner restricted for user, read for active emergencies
    match /emergency_events/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource == null || resource.data.user_id == request.auth.uid
      );
    }

    // 5. Route History: owner restricted
    match /route_history/{historyId} {
      allow read, write: if isAuthenticated() && (
        resource == null || resource.data.user_id == request.auth.uid
      );
    }

    // 6. Road Hazards: readable by all authenticated users; create/update by owner
    match /road_hazards/{hazardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource == null || resource.data.user_id == request.auth.uid
      );
    }

    // 7. Police Stations: public read, client write prohibited
    match /police_stations/{stationId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. Hospital Facilities: public read, client write prohibited
    match /hospital_facilities/{hospitalId} {
      allow read: if true;
      allow write: if false;
    }

    // 9. Accident Data: public read, client write prohibited
    match /accident_data/{accidentId} {
      allow read: if true;
      allow write: if false;
    }

    // 10. Traffic Data: public read, client write prohibited
    match /traffic_data/{trafficId} {
      allow read: if true;
      allow write: if false;
    }

    // 11. Traffic Hourly: public read, client write prohibited
    match /traffic_hourly/{hourlyId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
